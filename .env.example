# Base URL for the self-hosted FFmpeg core (ffmpeg-core.js + ffmpeg-core.wasm,
# from @ffmpeg/core@0.12.10/dist/umd). Required — video and audio conversion
# throws without it. Use an R2 custom domain, not the rate-limited *.r2.dev URL,
# and allow this app's origin in the bucket's CORS policy (see r2-cors.json).
NEXT_PUBLIC_FFMPEG_BASE_URL=https://convert-assets.highwall-lab.us.ci/ffmpeg-core/0.12.10

# Optional: the multi-threaded core (ffmpeg-core.js, .wasm and .worker.js from
# @ffmpeg/core-mt@0.12.10/dist/umd), in its own directory. Used on capable
# devices, with the single-threaded core as fallback. See README.
# NEXT_PUBLIC_FFMPEG_MT_BASE_URL=https://convert-assets.highwall-lab.us.ci/ffmpeg-core-mt/0.12.10

# Base path where the jSquash WASM image codecs (mozjpeg/libpng/libwebp) are
# served. Defaults to "/wasm", i.e. the files shipped under public/wasm/ by the
# static export (kept out of the JS bundle, lazy-fetched on first encode).
# Repopulate public/wasm/ after upgrading @jsquash/* with `npm run copy-wasm`.
NEXT_PUBLIC_ASSET_BASE=/wasm