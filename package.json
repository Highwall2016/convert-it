{
  "name": "convert-it",
  "version": "0.1.0",
  "description": "Convert any file to any format, entirely in your browser.",
  "homepage": "https://convert-it-8wh.pages.dev/",
  "repository": {
    "url": "https://github.com/Highwall2016/convert-it"
  },
  "bugs": {
    "url": "https://github.com/Highwall2016/convert-it/pulls"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/security-headers.mjs && node scripts/build-sw.mjs && node scripts/check-build-config.mjs",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs && node scripts/make-webm.mjs",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y-smoke.mjs",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "serve": "node scripts/serve-out.mjs",
    "icons": "node scripts/build-icons.mjs",
    "test:security-egress": "node scripts/security-egress-smoke.mjs",
    "test:access": "node scripts/access-gate-smoke.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hyzyla/pdfium": "^2.1.13",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@next/env": "15.5.27",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/jszip": "^3.4.0",
    "exifr": "7.1.3",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^11.0.0",
    "ico-codec": "^1.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "mammoth": "1.13.0",
    "marked": "^18.0.14",
    "mediabunny": "1.59.1",
    "next": "^15.5.26",
    "papaparse": "^5.5.3",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "2.18.0",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "utif2": "^4.1.0",
    "wasm-feature-detect": "^1.9.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.13.0",
    "canvas": "^3.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
